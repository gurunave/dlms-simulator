<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DlmsSimulatorGui.Api</RootNamespace>
    <!-- GXDLMSMeter.cs is linked from the Gurux simulator and raises many
         nullable / unused warnings we do not want to fail the build on. -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gurux.Net" Version="8.4.2503.1001" />
    <PackageReference Include="Gurux.Serial" Version="8.4.2503.603" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference the same DLMS library the official simulator uses. -->
    <ProjectReference Include="..\..\Gurux.DLMS.Net\Development\Gurux.DLMS.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Link the official simulator meter implementation unchanged.
         We subclass it (SimMeter) to add live-value event hooks. -->
    <Compile Include="..\..\Gurux.DLMS.Net\Gurux.DLMS.Simulator.Net\GXDLMSMeter.cs">
      <Link>Simulator\GXDLMSMeter.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the meter templates into the output so a published EXE is fully
         self-contained (no source tree needed at runtime). -->
    <Content Include="..\..\Gurux.DLMS.Net\Gurux.DLMS.Simulator.Net\*.xml"
             Link="templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Gurux.DLMS.Net\Gurux.DLMS.Simulator.Net\Templates\*.xml"
             Link="templates\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
